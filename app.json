{
  "expo": {
    "name": "KOOL Logistics",
    "slug": "kool-logistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "koollogistics",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F57D1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KOOL Logistics uses the camera to scan waybill QR codes on packages.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KOOL Logistics needs photo access so you can upload an image of a waybill QR code."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true
    },
    "backgroundColor": "#FFFFFF"
  }
}
