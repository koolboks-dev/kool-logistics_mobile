{
  "expo": {
    "name": "KOOL Logistics",
    "slug": "kool-logistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "koollogistics",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.koolboks.logistics",
      "adaptiveIcon": {
        "backgroundColor": "#F57D1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KOOL Logistics uses the camera to scan waybill QR codes and freezer serial barcodes, and to take proof-of-delivery photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KOOL Logistics needs photo access to upload waybill QR codes or proof-of-delivery photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KOOL Logistics shares your live location with retailers and dispatch while you are on duty or delivering an order."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.koolboks.logistics",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KOOL Logistics shares your live location with retailers and dispatch while you are on duty or delivering an order.",
        "NSCameraUsageDescription": "KOOL Logistics uses the camera to scan waybill QR codes and freezer serial barcodes, and to take proof-of-delivery photos.",
        "NSPhotoLibraryUsageDescription": "KOOL Logistics needs photo access to upload waybill QR codes or proof-of-delivery photos.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "whatsapp"
        ]
      }
    },
    "backgroundColor": "#FFFFFF",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25124c23-dff1-4c70-8df6-a432dd181bd4"
      }
    }
  }
}
